# ===== 数据库密码（自行生成强随机值） =====
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# ===== webhook 验证 token(改成随机字符串) =====
SNOV_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token

# 可选：用于自动管理 Snov webhook 与读取历史数据（不要提交真实值）
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# 每两分钟从 Snov 补拉邮件回复；webhook 仍负责实时推送。
SNOV_SYNC_ENABLED=true
SNOV_SYNC_INTERVAL_SECONDS=120

# ===== IMAP 附件同步（直连 Gmail 抓真附件，Snov 不传附件）=====
# 每 10 分钟轮询所有已配置邮箱的未读邮件；前端也可手动触发限定时间范围。
IMAP_SYNC_ENABLED=true
IMAP_SYNC_INTERVAL_SECONDS=600
# SOCKS5 代理。生产服务器若能直连 Google（海外 VPS）可设 false。
IMAP_PROXY_ENABLED=true
IMAP_PROXY_HOST=127.0.0.1
IMAP_PROXY_PORT=7897
ATTACHMENT_STORAGE_DIR=./data/attachments
# Fernet 主密钥（base64 urlsafe）。生产必填，否则密码降级明文存储。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATTACHMENT_MASTER_KEY=replace-with-a-fernet-key

# ===== KOL 采集接口内部令牌 =====
# 生成一个独立的强随机值；后端校验，Caddy 在服务器内部自动添加。
CRAWLER_TOKEN=replace-with-a-strong-random-token

# 可选：邮箱页“新邮件”按钮跳转地址。留空时按钮保持禁用。
VITE_SNOV_INBOX_URL=https://app.snov.io/

# ===== 看板登录账号（浏览器会弹出登录框） =====
DASHBOARD_USERNAME=replace-with-a-private-username
DASHBOARD_PASSWORD=replace-with-a-strong-password

# ===== OpenAI(填你的真实 key) =====
OPENAI_API_KEY=sk-xxxxx
OPENAI_BASE_URL=
OPENAI_MODEL_INTENT=gpt-4o-mini
OPENAI_MODEL_PERSONALIZE=gpt-4o

# ===== 公网 KOL 子域名（云服务器使用标准 80/443） =====
KOL_PUBLIC_DOMAIN=kol.example.com
KOL_HTTP_PORT=80
KOL_HTTPS_PORT=443

# DNSPod API Token（格式：DNSPod 控制台显示的 ID,Token；仅保存在 NAS 私有 .env.prod）
DNSPOD_TOKEN=your_dnspod_token_id,your_dnspod_token

# 同域部署时保持为空；若另有前端域名，再填精确 HTTPS 域名，多个用逗号分隔。
CORS_ORIGINS=

# 容器内轮转日志；生产环境也应采集 Docker stdout。
LOG_FILE=./logs/kol-outreach.log
