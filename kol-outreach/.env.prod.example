# ===== 数据库密码（自行生成强随机值） =====
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# ===== webhook 验证 token(改成随机字符串) =====
SNOV_WEBHOOK_TOKEN=replace-with-a-long-random-webhook-token

# 可选：用于自动管理 Snov webhook 与读取历史数据（不要提交真实值）
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# 每两分钟从 Snov 补拉邮件回复；webhook 仍负责实时推送。
SNOV_SYNC_ENABLED=true
SNOV_SYNC_INTERVAL_SECONDS=120

# ===== IMAP 附件同步（直连 Gmail 抓真附件，Snov 不传附件）=====
# 每 10 分钟轮询所有已配置邮箱的未读邮件；前端也可手动触发限定时间范围。
IMAP_SYNC_ENABLED=true
IMAP_SYNC_INTERVAL_SECONDS=600
# SOCKS5 代理。生产服务器若能直连 Google（海外 VPS）可设 false。
IMAP_PROXY_ENABLED=true
IMAP_PROXY_HOST=127.0.0.1
IMAP_PROXY_PORT=7897
SMTP_PROXY_ENABLED=true
SMTP_PROXY_HOST=127.0.0.1
SMTP_PROXY_PORT=7897
AUTO_REPLY_POLL_SECONDS=30
ATTACHMENT_STORAGE_DIR=./data/attachments
# Fernet 主密钥（base64 urlsafe）。生产必填，否则密码降级明文存储。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ATTACHMENT_MASTER_KEY=replace-with-a-fernet-key

# ===== KOL 采集接口内部令牌 =====
# 生成一个独立的强随机值；后端校验，Caddy 在服务器内部自动添加。
CRAWLER_TOKEN=replace-with-a-strong-random-token

# 可选：邮箱页“新邮件”按钮跳转地址。留空时按钮保持禁用。
VITE_SNOV_INBOX_URL=https://app.snov.io/

# ===== 看板登录账号（浏览器会弹出登录框） =====
DASHBOARD_USERNAME=replace-with-a-private-username
DASHBOARD_PASSWORD=replace-with-a-strong-password

# ===== OpenAI(填你的真实 key) =====
OPENAI_API_KEY=sk-xxxxx
OPENAI_BASE_URL=
OPENAI_MODEL_INTENT=gpt-4o-mini
OPENAI_MODEL_PERSONALIZE=gpt-4o

# ===== ScrapeCreators 社交平台抓取 API（YouTube/TikTok/Instagram）=====
# 第三方数据源：补齐 HTML 爬不到的 TikTok/IG profile 数据（粉丝/邮箱/国家）。
# 注册：app.scrapecreators.com → API Keys 页面生成。绝不提交真值。
SCRAPECREATORS_API_KEY=
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com
# 功能开关：true 时 crawler 的 ScrapeCreators 抓取阶段启用（按 API 计费，默认关）。
CRAWLER_ENABLE_SCRAPECREATORS=false

# ===== 飞书（Lark）电子表格回信同步 =====
# 收到 KOL 回信后，把该 KOL + 回信信息作为一行追加到飞书电子表格（Sheets）。
# 准备步骤：
#   1. https://open.feishu.cn/app 建企业自建应用，记下 App ID / App Secret
#   2. 权限管理开通 sheets:spreadsheet（电子表格读写）
#   3. 新建电子表格，URL 形如 .../sheets/<SPREADSHEET_TOKEN>
#   4. 表格「...」→ 添加文档应用 → 授权「可编辑」
#   5. 第一行按此顺序建表头：博主名/邮箱/频道链接/粉丝数/国家/赛道/
#      回信主题/回信内容/回信时间/营销活动/AI意向/AI摘要/中台ID
# ⚠️ 单一写入方：这张表只能由生产后端写。config 层有环境守卫，
# APP_ENV != production 时飞书写入直接禁用（prod compose 已硬编码
# APP_ENV=production，此处无需配置；本地/工作站禁止填生产表 token）。
FEISHU_ENABLE=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_API_BASE=https://open.feishu.cn/open-apis
FEISHU_SPREADSHEET_TOKEN=
# 工作表 sheet_id 可留空（自动用第一张工作表）
FEISHU_SHEET_ID=
FEISHU_SYNC_INTERVAL_SECONDS=60
FEISHU_RECONCILE_INTERVAL_SECONDS=1800

# ===== 公网 KOL 子域名（云服务器使用标准 80/443） =====
KOL_PUBLIC_DOMAIN=kol.example.com
KOL_HTTP_PORT=80
KOL_HTTPS_PORT=443

# DNSPod API Token（格式：DNSPod 控制台显示的 ID,Token；仅保存在 NAS 私有 .env.prod）
DNSPOD_TOKEN=your_dnspod_token_id,your_dnspod_token

# 同域部署时保持为空；若另有前端域名，再填精确 HTTPS 域名，多个用逗号分隔。
CORS_ORIGINS=

# 容器内轮转日志；生产环境也应采集 Docker stdout。
LOG_FILE=./logs/kol-outreach.log

# ===== 版本指纹(部署时由 deploy 脚本注入,也可手动填) =====
# 镜像构建时把这个 SHA 写进容器(/app/GIT_SHA + LABEL),用于线上追溯版本。
# 建议在 .env.prod 旁边用 deploy 脚本动态写入:
#   echo "GIT_SHA=$(git rev-parse HEAD)" >> .env.prod
#   echo "GIT_TAG=$(git rev-parse --short HEAD)" >> .env.prod
# 留空时容器会落到 "unknown",但仍可启动。
GIT_SHA=unknown
GIT_TAG=latest

# ===== IMAP 附件同步(2026-07-22 邮箱凭据模块新增) =====
# 总开关:false 时 attachment_scheduler 不启动轮询任务
IMAP_SYNC_ENABLED=true
# 轮询间隔(秒);默认 600 = 10 分钟
IMAP_SYNC_INTERVAL_SECONDS=600
# SOCKS5 代理(Gmail 在国内被墙,需要走代理;留空则直连)
IMAP_PROXY_ENABLED=false
IMAP_PROXY_HOST=
IMAP_PROXY_PORT=
SMTP_PROXY_ENABLED=false
SMTP_PROXY_HOST=
SMTP_PROXY_PORT=
AUTO_REPLY_POLL_SECONDS=30
# 附件落盘目录(容器内路径;留空 = ./data/attachments)
ATTACHMENT_STORAGE_DIR=/app/data/attachments
# Fernet 主密钥(AES128 + HMAC,加密邮箱应用专用密码)
# 生成方法:python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 丢了就解不开所有已加密的邮箱密码,必须多副本备份
ATTACHMENT_MASTER_KEY=change-me
