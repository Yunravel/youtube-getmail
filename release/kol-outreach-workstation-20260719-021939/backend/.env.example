# ===== 应用 =====
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ===== 数据库 =====
# 开发用 SQLite(无需额外安装)
DATABASE_URL=sqlite:///./kol_outreach.db
# 生产用 PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/kol_outreach

# ===== 跨域 =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== OpenAI =====
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL_INTENT=gpt-4o-mini
OPENAI_MODEL_PERSONALIZE=gpt-4o

# ===== Snov webhook =====
# Snov webhook 地址中携带的强随机 token；生产环境必须替换。
SNOV_WEBHOOK_TOKEN=change-me-to-a-long-random-string

# 可选：用于自动管理 webhook、读取 Campaign 和补同步历史数据
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# ===== 看板访问账号 =====
DASHBOARD_USERNAME=replace-with-a-private-username
DASHBOARD_PASSWORD=replace-with-a-strong-password

# ===== 发信约束 =====
MAX_DAILY_SEND_PER_MAILBOX=30
WARMUP_MIN_DAYS=14

# ===== 采集器（KOL 爬虫，内嵌于 services/crawler/）=====
# 三阶段并发上限（发现 / 频道 about 抓取 / MX 校验）
CRAWLER_MAX_CONCURRENCY_DISCOVERY=3
CRAWLER_MAX_CONCURRENCY_CHANNEL=6
CRAWLER_MAX_CONCURRENCY_MX=30
# 单页超时（秒）与请求间隔（秒，礼貌限速，避免被限流）
CRAWLER_REQUEST_TIMEOUT=20
CRAWLER_REQUEST_INTERVAL=0.2
# User-Agent
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/138 Safari/537.36

# ===== 采集功能开关（每个独立，前端请求可临时覆盖）=====
# 多平台扩展（从 about 抽 IG/TikTok/X 外链）
CRAWLER_ENABLE_ENRICH=true
# 公开邮箱采集 + MX 校验（YouTube about 页邮箱）
CRAWLER_ENABLE_EMAIL=true
# 官网深度邮箱采集（跟进 about 官网链接，用 Playwright 渲染抓 /contact 页）
# 默认关：慢（每站点起浏览器），需 pip install playwright + playwright install chromium，
# 且依赖住宅代理（KOL 官网多有 Cloudflare 防护，数据中心 IP 会被重置连接）。
CRAWLER_ENABLE_DEEP_EMAIL=false

# 采集端点鉴权 token（必填，否则端点 503 拒绝服务）。
# 前端用 VITE_CRAWLER_TOKEN 传同一个值。生成长随机串。
CRAWLER_TOKEN=replace-with-a-strong-random-token

# 住宅代理池（逗号分隔）。数据中心 IP 几乎必被 YouTube 封，生产环境必须配住宅代理。
# 留空则直连（仅适合本地开发或住宅网络直接出口）。
# 支持 http://user:pass@host:port 与 socks5://host:port 两种格式。
# 例：http://user1:pass1@proxy1.example.com:8080,http://user2:pass2@proxy2.example.com:8080
CRAWLER_PROXIES=
